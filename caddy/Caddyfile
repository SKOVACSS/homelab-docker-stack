# qBittorrent - Torrent client WebUI (VPN-routed via gluetun's network namespace)
qbit.{$DOMAIN} {
  import security_headers
  import rate_limit qbit
  reverse_proxy gluetun:{$QBIT_PORT} {
    header_up X-Real-IP {http.request.remote}
  }
}

