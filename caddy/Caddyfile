# PASSWORD), so no Caddy basic_auth layer here either.
slskd.{$DOMAIN} {
  import security_headers
  import rate_limit slskd
  reverse_proxy gluetun:{$SLSKD_WEBUI_PORT} {
    header_up X-Real-IP {http.request.remote}
  }
}

