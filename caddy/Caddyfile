# ========== EMAIL ==========
#
# email-stack was never turned on (no email-stack\.env - see that
# stack's docker-compose.yml comment), so mailu-admin/mailu-webmail/
# mailu-front don't exist. These 3 routes used to reverse_proxy to them
# anyway: Caddy still had live TLS certs for mailadmin./webmail.{$DOMAIN}
# and dutifully proxied to a backend that was never running, i.e. a
# real, publicly-reachable 502 for anyone who found those hostnames -
# dangling attack surface for a feature that was never actually
# deployed. Commented out until Mailu is actually running (run
# _scripts\enable-email.ps1 first) - uncomment then.
#
# All three routes below use {$MAIL_DOMAIN}, not {$DOMAIN} - deliberately
# a separate variable (defaults to the same value as DOMAIN if you never
# set it - see docker-compose.yml). This matters if your main domain
# already has real email service elsewhere (Proton Mail, Google Workspace,
# etc.): a domain can only have one real mail provider, since Mailu taking
# over MX records for a domain that's already receiving mail through
# another provider would break that provider's inbox. Point MAIL_DOMAIN at
# a second domain you're not already using for email, and Mailu runs
# there instead with zero conflict - see SETUP.md.

# Mailu admin panel
# Confirmed live: mailu-admin's gunicorn binds :8080 internally, not :80
# (this route was pointed at :80 before - a pre-existing bug, not
# introduced here, only surfaced by actually testing the container).
# mailadmin.{$MAIL_DOMAIN} {
#   import security_headers
#   log
#   import rate_limit mailadmin
#   reverse_proxy mailu-admin:8080 {
#     header_up X-Real-IP {http.request.remote}
#   }
# }

# Mailu webmail (Roundcube-successor webmail client)
# webmail.{$MAIL_DOMAIN} {
#   import security_headers
#   log
#   reverse_proxy mailu-webmail:80 {
#     header_up X-Real-IP {http.request.remote}
#   }
# }

# Mailu front - HTTP only, deliberately no TLS block on this site. Caddy
# must NOT obtain its own certificate for this hostname: mailu-front runs
# its own certbot for mail.{$MAIL_DOMAIN} (TLS_FLAVOR=letsencrypt), and
# Mailu's own docs are explicit that a reverse proxy in front of it should
# let Mailu keep doing its own cert issuance rather than duplicating it.
# This block exists only to let front's Let's Encrypt HTTP-01 challenge
# through; the actual encrypted mail protocols (SMTP/IMAP/POP3) bypass
# Caddy entirely via mailu-front's own directly-published ports.
# http://mail.{$MAIL_DOMAIN} {
#   reverse_proxy mailu-front:80
# }

# ========== DNS ==========

# Pi-hole admin UI. Actual DNS service (port 53) is published directly by
# the pihole container itself, not proxied through Caddy - only the web
# UI goes through here, same firewall model as every other admin panel.
pihole.{$DOMAIN} {
  import security_headers
  log
  import rate_limit pihole
  import authentik /api/*
  reverse_proxy pihole:80 {
    header_up X-Real-IP {http.request.remote}
  }
}

# ========== AI ==========

# Open WebUI - chat frontend for vllm (ai-stack), GPU-accelerated via
# Level-Zero/XPU - see TROUBLESHOOTING.md. vllm itself has no route -
# it's a backend API only this container needs to reach, same reasoning
# as immich-machine-learning not getting one either. Uses its own
# built-in login (first account created becomes admin), no Caddy
# basic_auth layer.
chat.{$DOMAIN} {
  import security_headers
  log
  import rate_limit chat
  # On demand: the AI stack (vllm + open-webui, ~2.6GB) stays stopped
  # until someone opens this site. Browsers get a "starting" page that
  # refreshes itself - vLLM loading the model onto the GPU takes 1-3
  # minutes - and the stack stops again after 30 minutes with no
  # requests. See the sablier service in docker-compose.yml.
  sablier http://sablier:10000 {
    group ai
    session_duration 30m
    dynamic {
      display_name "AI Chat"
      theme hacker-terminal
      refresh_frequency 5s
    }
  }
  reverse_proxy open-webui:8080 {
    header_up X-Real-IP {http.request.remote}
  }
}

