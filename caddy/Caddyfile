# ========== EMAIL ==========

# Mailu admin panel
# Confirmed live: mailu-admin's gunicorn binds :8080 internally, not :80
# (this route was pointed at :80 before - a pre-existing bug, not
# introduced here, only surfaced by actually testing the container).
mailadmin.{$DOMAIN} {
  import security_headers
  import rate_limit mailadmin
  reverse_proxy mailu-admin:8080 {
    header_up X-Real-IP {http.request.remote}
  }
}

# Mailu webmail (Roundcube-successor webmail client)
webmail.{$DOMAIN} {
  import security_headers
  reverse_proxy mailu-webmail:80 {
    header_up X-Real-IP {http.request.remote}
  }
}

# Mailu front - HTTP only, deliberately no TLS block on this site. Caddy
# must NOT obtain its own certificate for this hostname: mailu-front runs
# its own certbot for mail.{$DOMAIN} (TLS_FLAVOR=letsencrypt), and Mailu's
# own docs are explicit that a reverse proxy in front of it should let
# Mailu keep doing its own cert issuance rather than duplicating it. This
# block exists only to let front's Let's Encrypt HTTP-01 challenge through;
# the actual encrypted mail protocols (SMTP/IMAP/POP3) bypass Caddy
# entirely via mailu-front's own directly-published ports.
http://mail.{$DOMAIN} {
  reverse_proxy mailu-front:80
}

# ========== DNS ==========

# Pi-hole admin UI. Actual DNS service (port 53) is published directly by
# the pihole container itself, not proxied through Caddy - only the web
# UI goes through here, same firewall model as every other admin panel.
pihole.{$DOMAIN} {
  import security_headers
  import rate_limit pihole
  reverse_proxy pihole:80 {
    header_up X-Real-IP {http.request.remote}
  }
}

