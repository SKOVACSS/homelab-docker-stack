# Jellyfin - Open-source media server
# Browser remote desktop into this server (remote-stack's Guacamole).
# Guacamole itself redirects to Authentik and only admins get through -
# see remote-stack/docker-compose.yml. Asleep until opened (Sablier); the
# 4h idle window is long because a desktop session is one long-lived
# websocket, which Sablier only sees as a single request - a short window
# could stop Guacamole in the middle of someone's session.
remote.{$DOMAIN} {
  import security_headers
  log
  import rate_limit remote
  sablier http://sablier:10000 {
    group remote
    session_duration 4h
    dynamic {
      display_name "Remote Desktop"
      theme hacker-terminal
      refresh_frequency 3s
    }
  }
  reverse_proxy guacamole:8080 {
    header_up X-Real-IP {http.request.remote}
  }
}

jellyfin.{$DOMAIN} {
  import security_headers
  log
  # On demand, like chat. above - but "blocking", not a loading page:
  # Jellyfin's TV/phone apps can't render HTML, so the first request just
  # waits (up to 2 minutes) until Jellyfin is healthy, then goes through.
  # Stopped after an hour with no requests; an active stream keeps it up.
  sablier http://sablier:10000 {
    group jellyfin
    session_duration 1h
    blocking {
      timeout 2m
    }
  }
  reverse_proxy jellyfin:8096 {
    header_up X-Real-IP {http.request.remote}
  }
}

