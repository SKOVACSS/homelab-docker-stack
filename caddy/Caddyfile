# Caddy Reverse Proxy Configuration - Security Hardened
# Includes: HSTS, CSP, security headers, real rate limiting, auto-HTTPS
#
# Rate limiting uses the mholt/caddy-ratelimit plugin, compiled into the
# image via ./Dockerfile (the stock caddy image does not include it).
# {$DOMAIN} and {$QBIT_PORT} are substituted from the container's
# environment (see docker-compose.yml) at config-load time.

# Global settings
{
  email {$ACME_EMAIL}
  acme_ca https://acme-v02.api.letsencrypt.org/directory

  order rate_limit after basic_auth
}

# Security header middleware (applied to all routes)
(security_headers) {
  # HTTPS Strict Transport Security (force HTTPS for 1 year)
  header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Prevent MIME sniffing
  header X-Content-Type-Options "nosniff"

  # Prevent clickjacking
  header X-Frame-Options "SAMEORIGIN"

  # XSS Protection (deprecated but good fallback)
  header X-XSS-Protection "1; mode=block"

  # Content Security Policy (prevent injection attacks)
  header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https:;"

  # Referrer Policy (privacy)
  header Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions Policy (disable dangerous features)
  header Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"

  # Remove X-Powered-By (don't reveal tech stack)
  header -Server
}

# Rate limiting middleware (protect against brute force).
# Each call site passes a unique zone name (import rate_limit <name>) so
# multiple site blocks don't collide on one shared zone definition.
(rate_limit) {
  rate_limit {
    zone {args[0]}_zone {
      key    {remote_host}
      events 30
      window 1m
    }
  }
}

# ========== MEDIA APPS ==========

# Sonarr - TV shows automation
sonarr.{$DOMAIN} {
  import security_headers
  import rate_limit sonarr
  reverse_proxy sonarr:8989 {
    header_up X-Remote-User "authenticated"
  }
}

# Radarr - Movie automation
radarr.{$DOMAIN} {
  import security_headers
  import rate_limit radarr
  reverse_proxy radarr:7878 {
    header_up X-Remote-User "authenticated"
  }
}

