# Copy to offsite.env (same folder, git-ignored) to turn on off-site
# backups in backup.ps1. Every nightly -Full backup then also stores an
# encrypted, deduplicated Restic snapshot here.

# A folder inside the Proton Drive sync folder: the Proton Drive app
# uploads whatever Restic writes. Right-click the folder -> "Always keep
# on this device" so Windows never swaps the files for online-only
# placeholders. Any Restic backend URL (b2:..., s3:..., sftp:...) also works.
RESTIC_REPOSITORY=D:\ProtonDrive\My files\Homelab Backup

# Encrypts everything. Without it the off-site copy CANNOT be restored -
# keep a copy in Vaultwarden and on paper. Never change it after the
# first backup (use `restic key add` instead).
RESTIC_PASSWORD=

# Host folders that aren't Docker volumes, "name=path;name=path".
# Immich thumbnails/encoded-video are skipped (regenerated from originals).
OFFSITE_EXTRA_PATHS=immich=D:\DockerApplications\immich-app\library
