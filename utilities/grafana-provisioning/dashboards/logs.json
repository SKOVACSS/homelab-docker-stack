{
  "uid": "homelab-logs",
  "title": "Logs",
  "description": "Every container's logs (shipped by Alloy to Loki, kept 14 days). Pick a stack/container and optionally type a search term.",
  "tags": ["homelab"],
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "schemaVersion": 39,
  "templating": { "list": [
    { "name": "stack", "label": "Stack", "type": "query", "datasource": { "type": "loki", "uid": "loki" },
      "query": { "label": "stack", "refId": "LokiVariableQueryEditor-VariableQuery", "stream": "", "type": 1 },
      "includeAll": true, "multi": true, "allValue": ".*", "current": { "text": "All", "value": "$__all" }, "refresh": 2 },
    { "name": "container", "label": "Container", "type": "query", "datasource": { "type": "loki", "uid": "loki" },
      "query": { "label": "container", "refId": "LokiVariableQueryEditor-VariableQuery", "stream": "", "type": 1 },
      "includeAll": true, "multi": true, "allValue": ".+", "current": { "text": "All", "value": "$__all" }, "refresh": 2 },
    { "name": "search", "label": "Search (regex, case-insensitive)", "type": "textbox", "query": "", "current": { "text": "", "value": "" } }
  ] },
  "panels": [
    {
      "type": "timeseries", "title": "Log volume", "gridPos": { "h": 7, "w": 16, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [ { "refId": "A", "expr": "sum by (container) (count_over_time({stack=~\"$stack\", container=~\"$container\"} |~ \"(?i)$search\" [$__interval]))", "legendFormat": "{{container}}" } ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60, "stacking": { "mode": "normal" } } } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "type": "bargauge", "title": "Error lines by container (time range)", "gridPos": { "h": 7, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [ { "refId": "A", "expr": "topk(10, sum by (container) (count_over_time({stack=~\"$stack\", container=~\"$container\"} |~ \"(?i)\\\\b(error|fatal|panic|exception)\\\\b\" [$__range])))", "legendFormat": "{{container}}", "queryType": "instant" } ],
      "options": { "orientation": "horizontal", "displayMode": "basic", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "logs", "title": "Logs", "gridPos": { "h": 20, "w": 24, "x": 0, "y": 7 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [ { "refId": "A", "expr": "{stack=~\"$stack\", container=~\"$container\"} |~ \"(?i)$search\"" } ],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true, "dedupStrategy": "none" }
    }
  ]
}
