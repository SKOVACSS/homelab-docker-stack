# ============================================================================
# This is a REFERENCE INDEX, not a file to copy.
# ============================================================================
# Each stack is its own Docker Compose project with its OWN .env file in its
# own directory (authentik/.env, caddy/.env, media-stack/.env, etc.) - there
# is no single combined .env for the whole repo. Docker Compose reads the
# .env next to the compose file it's given, automatically.
#
# Fastest path: run `_scripts\gui-installer.ps1` - it writes every stack's
# .env for you with correctly-named, unique, cryptographically-random
# secrets. See SETUP.md.
#
# This file just lists every variable, grouped by which stack's .env it
# belongs in, for reference/auditing. The values below are examples, not
# real generated secrets.
# ============================================================================

# ===== caddy/.env =====
DOMAIN=yourdomain.com
ACME_EMAIL=your-email@example.com
QBIT_PORT=8080                        # must match media-stack/.env's QBIT_PORT
SLSKD_WEBUI_PORT=5030                 # must match media-stack/.env's SLSKD_WEBUI_PORT
# Cloudflare API token (Zone:DNS:Edit, scoped to this domain only) - lets
# Caddy issue real certs via DNS-01 with no inbound port needed. Create at
# https://dash.cloudflare.com/profile/api-tokens - see SETUP.md.
CLOUDFLARE_API_TOKEN=CHANGE_ME_CLOUDFLARE_DNS_EDIT_TOKEN
# The token for the Cloudflare Tunnel itself (a different kind of token -
# from Zero Trust -> Networks -> Tunnels -> your tunnel -> Install
# connector). Not something this repo can generate - see SETUP.md.
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME_CLOUDFLARE_TUNNEL_TOKEN
# Optional - only set this if email-stack/'s Mailu needs to live on a
# DIFFERENT domain than everything else (e.g. DOMAIN above already has
# real email through another provider like Proton Mail or Google
# Workspace - a domain can only have one real mail provider at a time).
# Leave unset/commented to use DOMAIN for Mailu too (the previous
# behavior). If set, CLOUDFLARE_API_TOKEN above needs Zone:DNS:Edit
# permission for THIS domain as well, not just DOMAIN. See SETUP.md.
# MAIL_DOMAIN=your-other-domain.com
# Basic-auth in front of Radicale (family-facing calendar/contacts) -
# needed because Radicale's OWN auth is deliberately disabled entirely
# (RADICALE_AUTH_TYPE=none in privacy-stack/.env), so this is the only
# real gate it has. RADICALE_AUTH_HASH is a bcrypt hash, not plaintext -
# gui-installer.ps1 generates the plaintext password and this hash
# together via `caddy hash-password`, and doubles every literal $
# (CHANGE_ME_ below isn't a real hash, so this doesn't apply to it, but a
# real one always needs it - see TROUBLESHOOTING.md's Portainer entry for
# why). Sonarr/Radarr/Prowlarr/Lidarr and qBittorrent used to have a
# similar Caddy-level basic-auth layer too (ARR_AUTH_*/QBIT_AUTH_*) -
# removed once confirmed each already has its own real, mandatory login
# (Settings > General > Security), making Caddy's copy pure redundant
# friction with worse autofill than each app's own login form.
RADICALE_AUTH_USER=family
RADICALE_AUTH_HASH=CHANGE_ME_BCRYPT_HASH_FROM_CADDY_HASH-PASSWORD

# ===== authentik/.env =====
PG_USER=authentik
PG_PASS=CHANGE_ME_STRONG_PASSWORD
PG_DB=authentik
SECRET_KEY=CHANGE_ME_GENERATE_WITH_PYTHON
BOOTSTRAP_PASSWORD=CHANGE_ME_YOUR_ADMIN_PASSWORD
BOOTSTRAP_TOKEN=CHANGE_ME_GENERATE_WITH_PYTHON
# Read by authentik/blueprints/*.yaml, which define each app's OIDC login.
DOMAIN=yourdomain.com
# Must equal GRAFANA_OIDC_CLIENT_SECRET in utilities/.env.
GRAFANA_OIDC_CLIENT_SECRET=CHANGE_ME_GENERATE_WITH_PYTHON
# App logins (blueprints/app-logins.yaml) - each must equal the same
# variable in that app's stack .env (privacy-stack, ai-stack, utilities).
NEXTCLOUD_OIDC_CLIENT_SECRET=CHANGE_ME_GENERATE_WITH_PYTHON
PAPERLESS_OIDC_CLIENT_SECRET=CHANGE_ME_GENERATE_WITH_PYTHON
OPENWEBUI_OIDC_CLIENT_SECRET=CHANGE_ME_GENERATE_WITH_PYTHON
PORTAINER_OIDC_CLIENT_SECRET=CHANGE_ME_GENERATE_WITH_PYTHON
HOMEPAGE_FAMILY_OIDC_CLIENT_SECRET=CHANGE_ME_GENERATE_WITH_PYTHON
AUDIOBOOKSHELF_OIDC_CLIENT_SECRET=CHANGE_ME_GENERATE_WITH_PYTHON
MEALIE_OIDC_CLIENT_SECRET=CHANGE_ME_GENERATE_WITH_PYTHON
ACTUAL_OIDC_CLIENT_SECRET=CHANGE_ME_GENERATE_WITH_PYTHON

# ===== media-stack/.env =====
PROTON_OPENVPN_USERNAME=your-username+sXXXXXXXX@protonvpn.com
PROTON_OPENVPN_PASSWORD=your-generated-password
PROTON_WIREGUARD_KEY=                 # only if VPN_TYPE=wireguard
PROTON_WIREGUARD_ADDRESSES=           # only if VPN_TYPE=wireguard
PROTON_COUNTRIES=United States         # gluetun wants the full country name, not a code like "US" - confirmed live
VPN_TYPE=openvpn
QBIT_PORT=8080                        # WebUI, static
BT_PORT=6969                          # peer port - must match ProtonVPN's forwarded port
QBIT_DOWNLOADS_PATH=D:\Media\Downloads
MEDIA_MOVIES=D:\Media\Movies
MEDIA_TV=D:\Media\TV
MEDIA_MUSIC=D:\Media\Music
MEDIA_BOOKS=D:\Media\Books
MEDIA_PHOTOS=D:\Media\Photos
# Shared staging folder between LazyLibrarian (drops finished IRC/XDCC
# downloads here) and Calibre-Web-Automated (watches this same folder,
# converts, imports into CALIBRE_LIBRARY_PATH, then removes the original)
# - see SETUP.md.
BOOKS_INGEST_PATH=D:\Media\Downloads\books
# LazyLibrarian's audiobook destination - same folder as family-stack's
# AUDIOBOOKS_PATH (Audiobookshelf's library).
AUDIOBOOKS_PATH=D:\Media\Audiobooks
# The actual Calibre library root (must contain metadata.db directly, not
# nested under it) - point this at an existing Calibre library if you
# have one, not just anywhere under MEDIA_BOOKS.
CALIBRE_LIBRARY_PATH=D:\Media\Books\CalibreLibrary
PLEX_CLAIM_TOKEN=claim-xxxxxxxxxxxxxxxxxxxxx
PLEX_DOMAIN=plex.yourdomain.com
JELLYFIN_DOMAIN=jellyfin.yourdomain.com
TZ=America/Chicago
# Auto-detected and written by _scripts/detect-gpu.ps1 (runs automatically
# before every deploy.ps1 deploy) - which GPU-acceleration profile Plex/
# Jellyfin's transcoding uses (cpu/nvenc/quicksync/vaapi/vaapi-wsl). Safe
# to leave unset; defaults to cpu (software) either way. See
# media-stack/hwaccel.transcoding.yml for what each profile maps to.
PLEX_HWACCEL=cpu
JELLYFIN_HWACCEL=cpu
# Unpackerr (archive auto-extraction) needs each app's own API key to poll
# its queue - these are generated by Sonarr/Radarr/Lidarr/Prowlarr on
# first boot, not by this stack, so there's nothing to fill in until
# after those apps are already running. Find each one at Settings >
# General > Security > API Key in that app's own web UI, then paste it
# here and redeploy.
SONARR_API_KEY=CHANGE_ME_FROM_SONARR_SETTINGS
RADARR_API_KEY=CHANGE_ME_FROM_RADARR_SETTINGS
LIDARR_API_KEY=CHANGE_ME_FROM_LIDARR_SETTINGS
PROWLARR_API_KEY=CHANGE_ME_FROM_PROWLARR_SETTINGS

# slskd (Soulseek client) + soularr (bridges it to Lidarr's wanted list) -
# see SETUP.md and media-stack/soularr/config.ini.example.
# 42300, not slskd's documented default of 50300 - that default falls
# inside Windows' Hyper-V dynamic port exclusion range on most machines
# (`netsh int ipv4 show excludedportrange protocol=tcp`), which fails the
# container with "bind: An attempt was made to access a socket in a way
# forbidden by its access permissions" - confirmed live. Check your own
# machine's excluded ranges before picking a different port than this.
SLSK_PORT=42300
SLSKD_WEBUI_PORT=5030
SLSKD_DOWNLOADS_PATH=D:\Media\Downloads\soulseek
# Your actual Soulseek network identity - this is a public handle other
# Soulseek users see, not an internal service account. Soulseek has no
# separate signup step: whatever username/password you pick here is
# registered automatically the first time slskd connects with it.
SLSKD_SLSK_USERNAME=CHANGE_ME_PICK_A_SOULSEEK_USERNAME
SLSKD_SLSK_PASSWORD=CHANGE_ME_PICK_A_SOULSEEK_PASSWORD
# slskd's own web UI login - unrelated to the Soulseek account above.
SLSKD_USERNAME=admin
SLSKD_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# soularr needs this to call slskd's REST API - generate with
# `openssl rand -hex 16` (or any 32-char random hex string) and put the
# same value in both here and media-stack/soularr/config.ini's [Slskd]
# api_key.
SLSKD_API_KEY=CHANGE_ME_GENERATE_32_CHAR_HEX
# qBittorrent and Seerr generate their own API keys internally (qBittorrent:
# Settings > WebUI > Authentication > API Key, needs qBittorrent >= v5.2;
# Seerr: Settings > General > API Key) - there's no env var that feeds a
# key INTO either app, unlike SLSKD_API_KEY above. These two only exist
# here so dashboard/.env (Homepage's widgets) can reuse the same value -
# copy each one out of its app's own UI after first setup.
QBIT_API_KEY=CHANGE_ME_FROM_QBITTORRENT_WEBUI_SETTINGS
SEERR_API_KEY=CHANGE_ME_FROM_SEERR_SETTINGS

# ===== ai-stack/.env =====
DOMAIN=yourdomain.com
OPENWEBUI_OIDC_CLIENT_SECRET=CHANGE_ME_SAME_AS_AUTHENTIK_ENV

# ===== privacy-stack/.env =====
DOMAIN=yourdomain.com
# Same values as authentik/.env. Nextcloud's side is applied by
# _scripts/configure-nextcloud-oidc.ps1.
NEXTCLOUD_OIDC_CLIENT_SECRET=CHANGE_ME_SAME_AS_AUTHENTIK_ENV
PAPERLESS_OIDC_CLIENT_SECRET=CHANGE_ME_SAME_AS_AUTHENTIK_ENV
MEDIA_MUSIC=D:\Media\Music
SYNC_FOLDER=D:\Sync
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
NEXTCLOUD_DB_PASS=CHANGE_ME_STRONG_PASSWORD
NEXTCLOUD_DB_ROOT_PASS=CHANGE_ME_STRONG_PASSWORD
NEXTCLOUD_DATA=D:\Nextcloud
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
PAPERLESS_SECRET_KEY=CHANGE_ME_GENERATE_WITH_PYTHON
PAPERLESS_DB_PASS=CHANGE_ME_STRONG_PASSWORD
PAPERLESS_CONSUME=D:\Paperless\consume
WALLABAG_DB_PASS=CHANGE_ME_STRONG_PASSWORD
WALLABAG_EMAIL=admin@yourdomain.com
MAILER_HOST=smtp.gmail.com
MAILER_PORT=587

# ===== security-stack/.env =====
DOMAIN=yourdomain.com
WIREGUARD_DOMAIN=vpn.yourdomain.com
TZ=UTC

# ===== email-stack/.env =====
# This can be the same as your main domain, or a different one entirely -
# whatever you set MAIL_DOMAIN to in caddy/.env (defaults to the main
# DOMAIN if you never set that) must match this value exactly.
DOMAIN=yourdomain.com
MAILU_SECRET_KEY=CHANGE_ME_GENERATE_WITH_PYTHON
MAIL_ADMIN_USER=admin
MAIL_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
TZ=UTC

# ===== monitoring-stack/.env =====
DOMAIN=yourdomain.com
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Must match INFLUXDB_ADMIN_TOKEN in utilities/.env exactly - the one
# Grafana instance (in utilities) uses this to query InfluxDB.
INFLUXDB_ADMIN_TOKEN=CHANGE_ME_GENERATE_WITH_PYTHON
TZ=UTC

# ===== notification-stack/.env =====
DOMAIN=yourdomain.com
GOTIFY_ADMIN_USER=admin
GOTIFY_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
TZ=UTC

# ===== utilities/.env =====
DOMAIN=yourdomain.com
VAULTWARDEN_ADMIN_TOKEN=CHANGE_ME_GENERATE_WITH_PYTHON
VAULTWARDEN_SIGNUPS_ALLOWED=false
VAULTWARDEN_INVITATIONS_ALLOWED=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Must match INFLUXDB_ADMIN_TOKEN in monitoring-stack/.env exactly.
INFLUXDB_ADMIN_TOKEN=CHANGE_ME_GENERATE_WITH_PYTHON
# Portainer's admin account is set through its web UI on first visit -
# there is no env var for it. See TROUBLESHOOTING.md.
# Optional - Watchtower -> Gotify notifications on update (off unless set):
GOTIFY_TOKEN=CHANGE_ME_CREATE_A_GOTIFY_APPLICATION
WATCHTOWER_NOTIFICATIONS=shoutrrr
# Uptime Kuma admin login, created on your first visit to uptime.DOMAIN.
# AutoKuma logs in with it to create the monitors in
# utilities/autokuma/monitors/ - fill these in, then restart autokuma.
UPTIME_KUMA_USERNAME=
UPTIME_KUMA_PASSWORD=
# "Sign in with Authentik" for Grafana. Same random value as in
# authentik/.env (generate once, e.g. 48 random characters).
GRAFANA_OIDC_ENABLED=true
GRAFANA_OIDC_CLIENT_SECRET=CHANGE_ME_SAME_AS_AUTHENTIK_ENV
# Paste into Portainer -> Settings -> Authentication -> OAuth (Portainer
# stores it in its own database; nothing reads it from here).
PORTAINER_OIDC_CLIENT_SECRET=CHANGE_ME_SAME_AS_AUTHENTIK_ENV

# ===== dashboard/.env =====
DOMAIN=yourdomain.com
# Homepage has no login of its own by default - these enable OIDC login
# via Authentik instead of leaving it wide open. HOMEPAGE_AUTH_SECRET
# signs Homepage's own session cookie (32+ random chars, unrelated to the
# OIDC secret below); CLIENT_ID/CLIENT_SECRET come from an OAuth2
# Provider + Application you create in Authentik (name/slug "homepage",
# redirect URI https://dash.yourdomain.com/api/auth/callback/homepage-oidc) -
# not something gui-installer.ps1 can generate for you, since Authentik
# itself has to exist and be configured first. See TROUBLESHOOTING.md if
# you hit "invalid_request" or a JWT algorithm mismatch setting this up -
# both are easy to hit creating the provider by hand/API instead of
# through Authentik's own UI wizard.
HOMEPAGE_AUTH_SECRET=CHANGE_ME_32_PLUS_RANDOM_CHARS
HOMEPAGE_OIDC_CLIENT_ID=CHANGE_ME_FROM_AUTHENTIK_PROVIDER
HOMEPAGE_OIDC_CLIENT_SECRET=CHANGE_ME_FROM_AUTHENTIK_PROVIDER
# Family dashboard (home.yourdomain.com). Its Authentik provider comes
# from authentik/blueprints/dashboards.yaml - the OIDC secret must equal
# the same variable in authentik/.env; the AUTH secret is its own.
HOMEPAGE_FAMILY_AUTH_SECRET=CHANGE_ME_32_PLUS_RANDOM_CHARS
HOMEPAGE_FAMILY_OIDC_CLIENT_SECRET=CHANGE_ME_SAME_AS_AUTHENTIK_ENV
# Widget credentials for the live stat tiles (Pi-hole, Sonarr, Radarr,
# Lidarr, Prowlarr, Seerr, qBittorrent, slskd) - same values already
# sitting in dns-stack/.env and media-stack/.env respectively, copied
# here because each stack's docker-compose.yml only reads its own .env
# file, not another stack's.
PIHOLE_WEBPASSWORD=CHANGE_ME_SAME_AS_DNS_STACK_ENV
SONARR_API_KEY=CHANGE_ME_SAME_AS_MEDIA_STACK_ENV
RADARR_API_KEY=CHANGE_ME_SAME_AS_MEDIA_STACK_ENV
LIDARR_API_KEY=CHANGE_ME_SAME_AS_MEDIA_STACK_ENV
PROWLARR_API_KEY=CHANGE_ME_SAME_AS_MEDIA_STACK_ENV
SEERR_API_KEY=CHANGE_ME_SAME_AS_MEDIA_STACK_ENV
QBIT_API_KEY=CHANGE_ME_SAME_AS_MEDIA_STACK_ENV
SLSKD_API_KEY=CHANGE_ME_SAME_AS_MEDIA_STACK_ENV

# ===== dns-stack/.env =====
PIHOLE_WEBPASSWORD=CHANGE_ME_STRONG_PASSWORD
TZ=UTC

# ===== crowdsec-stack/.env =====
# Optional stack, off by default - see _scripts/enable-crowdsec.ps1 and
# SETUP.md. This is the only real setting here; the Cloudflare bouncer's
# own credentials live in crowdsec-stack/cloudflare-bouncer.yaml instead
# (gitignored, generated by enable-crowdsec.ps1 - see
# cloudflare-bouncer.yaml.example for the shape), not a normal .env, since
# they include a CrowdSec-minted API key that can't be known ahead of time.
TZ=UTC

# ===== immich-app/.env =====
UPLOAD_LOCATION=./library
DB_DATA_LOCATION=./postgres
IMMICH_VERSION=v3.2.2
DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
# Auto-detected and written by _scripts/detect-gpu.ps1 (runs automatically
# before every deploy.ps1 deploy) - same idea as PLEX_HWACCEL/
# JELLYFIN_HWACCEL above, but split in two because Immich's machine
# learning (face detection, smart search) and video transcoding use
# different acceleration backends. ML_IMAGE_SUFFIX picks the matching
# image variant (e.g. "-openvino", "-cuda") - empty string for cpu. Safe
# to leave all three unset; every one defaults to cpu/no-suffix either
# way. See immich-app/hwaccel.ml.yml and hwaccel.transcoding.yml for what
# each profile maps to.
TRANSCODE_HWACCEL=cpu
ML_HWACCEL=cpu
ML_IMAGE_SUFFIX=

# ============================================================================
# Generate any CHANGE_ME_* value with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Never commit real .env files to git - see .gitignore.
# ============================================================================

# ===== family-stack/.env =====
DOMAIN=yourdomain.com
TZ=America/Toronto
AUDIOBOOKS_PATH=D:\Media\Audiobooks
PODCASTS_PATH=D:\Media\Podcasts
# Same values as authentik/.env. Audiobookshelf's is pasted into its own
# Settings -> Authentication page (nothing reads it from here).
AUDIOBOOKSHELF_OIDC_CLIENT_SECRET=CHANGE_ME_SAME_AS_AUTHENTIK_ENV
MEALIE_OIDC_CLIENT_SECRET=CHANGE_ME_SAME_AS_AUTHENTIK_ENV
ACTUAL_OIDC_CLIENT_SECRET=CHANGE_ME_SAME_AS_AUTHENTIK_ENV
