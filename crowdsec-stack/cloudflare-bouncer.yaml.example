# Template only - the real file (cloudflare-bouncer.yaml, gitignored,
# same reasoning as every .env in this repo) is generated by
# _scripts/enable-crowdsec.ps1, which runs:
#   docker run crowdsecurity/cloudflare-worker-bouncer -g <CLOUDFLARE_TOKEN>
# against the broad-permission Cloudflare API token SETUP.md walks you
# through creating - that auto-fills your real account_id/zone_id, which
# can't be known ahead of time here. This file just documents the shape
# so you know what to expect / can hand-edit later.

crowdsec_config:
  lapi_url: http://crowdsec:8080/
  # Set by enable-crowdsec.ps1 via `cscli -oraw bouncers add cloudflarebouncer`
  # run against the crowdsec container above - can only be generated
  # after that container is already up, which is why this can't be
  # pre-filled the way every other credential in this repo is.
  lapi_key: CHANGE_ME_FROM_CSCLI_BOUNCERS_ADD
  update_frequency: 10s

cloudflare_config:
  accounts:
    - id: CHANGE_ME_AUTO_FILLED_BY_GENERATE_STEP
      ban_template: "" # empty = Cloudflare's default ban page
      zones:
        - zone_id: CHANGE_ME_AUTO_FILLED_BY_GENERATE_STEP # your domain
          actions:
            - ban
          default_action: ban
          routes_to_protect:
            - "*{$DOMAIN}/*"
          turnstile:
            enabled: false # only needed if using the captcha action
  update_frequency: 30s

log_mode: stdout
log_level: info

prometheus:
  enabled: false
  listen_addr: 0.0.0.0
  listen_port: 2112
