[Lidarr]
api_key = CHANGE_ME_SAME_AS_LIDARR_API_KEY_IN_ENV
host_url = http://lidarr:8686
# The SAME host folder slskd downloads into, but as Lidarr's OWN container
# sees it - see the extra volume mount added to lidarr's service block in
# media-stack/docker-compose.yml. Do not point this at Lidarr's normal
# /downloads - that's qBittorrent's folder, a different mount.
download_dir = /downloads-soulseek
disable_sync = False

[Slskd]
api_key = CHANGE_ME_SAME_AS_SLSKD_API_KEY_IN_ENV
# "gluetun", not "slskd" - slskd runs on network_mode: service:gluetun (to
# tunnel its P2P traffic through the VPN, same as qBittorrent), so it has
# no network identity of its own. See the qBittorrent and slskd comments
# in media-stack/docker-compose.yml for the fuller explanation.
host_url = http://gluetun:5030
url_base = /
download_dir = /downloads
delete_searches = False
stalled_timeout = 3600
remote_queue_timeout = 300

[Release Settings]
use_selected_lidarr_release = False
use_most_common_tracknum = True
allow_multi_disc = True
accepted_countries = Europe,Japan,United Kingdom,United States,[Worldwide],Australia,Canada
skip_region_check = False
accepted_formats = CD,Digital Media,Vinyl

[Search Settings]
search_timeout = 5000
maximum_peer_queue = 50
minimum_peer_upload_speed = 0
minimum_filename_match_ratio = 0.8
minimum_search_interval = 5
# Already FLAC-first by upstream default - matches wanting hi-res/lossless
# over lossy formats. Reorder or trim if you'd rather accept mp3 sooner.
allowed_filetypes = flac 24/192,flac 16/44.1,flac,mp3 320,mp3
ignored_users =
album_prepend_artist = False
search_type = incrementing_page
number_of_albums_to_grab = 10
title_blacklist =
search_blacklist =
search_source = missing
failed_import_denylist = True

[Download Settings]
download_filtering = True
use_extension_whitelist = False
extensions_whitelist = lrc,nfo,txt
rename_download_folders = True

[Logging]
level = INFO
format = [%(levelname)s|%(module)s|L%(lineno)d] %(asctime)s: %(message)s
datefmt = %Y-%m-%dT%H:%M:%S%z
log_to_file = True
log_file = soularr.log
max_bytes = 1048576
backup_count = 3
