# yaml-language-server: $schema=https://schemas.recyclarr.dev/v8/config-schema.json
################################################################################
## Recyclarr - syncs TRaSH Guides' community-maintained Custom Formats and
## Quality Profiles into Sonarr/Radarr, so releases get SCORED and the best
## available one is grabbed automatically, instead of just taking whatever a
## search returns first. Rejects cam/telesync/upscaled/fake releases outright
## and prefers well-regarded release groups, proper HDR handling, etc.
##
## Profiles pulled from https://github.com/recyclarr/config-templates (HD +
## UHD templates per app, merged - see below for why they're merged rather
## than left as four separate top-level instances).
##
## IMPORTANT: both quality profiles per app are combined under ONE instance
## block (one `radarr:` entry, one `sonarr:` entry), NOT left as four
## separate top-level instances the way the individual TRaSH/Recyclarr
## template files ship them. Confirmed live: when multiple instance
## definitions share the same base_url, Recyclarr's "split instances" step
## silently skips ALL of them during a bare `recyclarr sync` (or any sync
## with more than one instance sharing a URL) - no error, exit code 0, but
## nothing actually syncs. A single instance with multiple entries in
## `quality_profiles` is the documented, correct way to give one Radarr/
## Sonarr server more than one TRaSH quality profile - see
## https://recyclarr.dev/reference/config-examples and TROUBLESHOOTING.md.
##
## Re-running `docker compose run --rm recyclarr sync` after editing this
## file (or waiting for its own schedule, see CRON_SCHEDULE in
## docker-compose.yml) applies changes.
################################################################################

radarr:
  movies:
    base_url: http://radarr:7878
    api_key: CHANGE_ME_SAME_AS_RADARR_API_KEY_IN_ENV

    # No quality_definition here on purpose: _scripts/configure-quality-profiles.ps1
    # sets custom per-quality max sizes, and Recyclarr's daily sync would
    # overwrite them with TRaSH defaults (confirmed live - it did).

    quality_profiles:
      - trash_id: d1d67249d3890e49bc12e275d989a7e9 # HD Bluray + WEB
        reset_unmatched_scores:
          enabled: true
      - trash_id: 64fb5f9858489bdac2af690e27c8f42f # UHD Bluray + WEB
        reset_unmatched_scores:
          enabled: true

    custom_format_groups:
      add:
        - trash_id: f8bf8eab4617f12dfdbd16303d8da245 # [Optional] Golden Rule HD
        - trash_id: ff204bbcecdd487d1cefcefdbf0c278d # [Optional] Golden Rule UHD
        - trash_id: a3ac6af01d78e4f21fcb75f601ac96df # [Unwanted] Unwanted Formats

sonarr:
  tv:
    base_url: http://sonarr:8989
    api_key: CHANGE_ME_SAME_AS_SONARR_API_KEY_IN_ENV

    # No quality_definition here - same reason as the radarr section above.

    quality_profiles:
      - trash_id: 72dae194fc92bf828f32cde7744e51a1 # WEB-1080p
        reset_unmatched_scores:
          enabled: true
      - trash_id: d1498e7d189fbe6c7110ceaabb7473e6 # WEB-2160p
        reset_unmatched_scores:
          enabled: true

    custom_format_groups:
      add:
        - trash_id: 158188097a58d7687dee647e04af0da3 # [Optional] Golden Rule HD
        - trash_id: e3f37512790f00d0e89e54fe5e790d1c # [Optional] Golden Rule UHD
        - trash_id: 74aff4168620ed49dcc67e92b2c2a5b4 # [Optional] Language Profiles
        - trash_id: 85fae4a2294965b75710ef2989c850eb # [Streaming Services] HD/UHD boost
        - trash_id: 59c3af66780d08332fdc64e68297098f # [Unwanted] Unwanted Formats
