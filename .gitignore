# Real secrets - every stack's .env holds live credentials. Never commit these.
**/.env
!.env.example
**/.env.validate-stacks-backup

# soularr's config.ini holds real Lidarr/slskd API keys - same reasoning
# as .env above. config.ini.example is the committed template.
media-stack/soularr/config.ini

# recyclarr.yml holds real Sonarr/Radarr API keys - same reasoning as
# .env above. recyclarr.yml.example is the committed template.
media-stack/recyclarr/recyclarr.yml
media-stack/recyclarr/logs/
media-stack/recyclarr/repo/
media-stack/recyclarr/cache/

# cloudflare-bouncer.yaml holds a real CrowdSec LAPI key and Cloudflare
# account/zone IDs - same reasoning as .env above.
# cloudflare-bouncer.yaml.example is the committed template.
crowdsec-stack/cloudflare-bouncer.yaml
# Real CrowdSec bouncer config for Caddy (holds the LAPI key) - the
# *.caddy.example templates next to them are what gets committed.
caddy/crowdsec.d/*.caddy

# gui-installer.ps1's password-manager import file - plaintext, meant to
# be imported into Vaultwarden/Proton Pass and then deleted, not kept.
credentials-export.json
credentials-export.csv

# Local tooling config, not part of the project
.claude/

# Docker/runtime state that shouldn't be versioned
**/gluetun/
**/wireguard/config/
immich-app/library/
immich-app/postgres/

# Fail2Ban's persistent ban database and auto-created action.d scaffolding
# (crazymax/fail2ban creates this on first run, empty unless you add a
# custom action) - genuine runtime state, not config. jail.d/ and
# filter.d/ under the same fail2ban/data/ directory ARE real config
# (this image's own convention - see security-stack/docker-compose.yml)
# and are deliberately NOT excluded here.
**/fail2ban/data/db/
**/fail2ban/data/action.d/

# Homepage bind-mounts ./config directly and writes these itself at
# runtime (a sample kubernetes.yaml stub and its own log file) - not
# checked-in config, just generated state that lands in the same folder.
dashboard/config/kubernetes.yaml
dashboard/config/logs/

# Backups (these can be large and contain the same secrets as .env)
_scripts/backups/

# OS/editor cruft
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/
